{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "sql_execute",
        "hooks": [
          {
            "type": "command",
            "command": "bash .cortex/hooks/block-bronze-writes.sh",
            "timeout": 10,
            "enabled": true,
            "statusMessage": "Checking BRONZE protection policy..."
          }
        ]
      }
    ]
  }
}
